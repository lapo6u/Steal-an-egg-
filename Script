local Verifying = false

local function AcceptKey()
    local CoverIn = TweenService:Create(TransitionCover, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0})
    CoverIn:Play()
    CoverIn.Completed:Wait()
    KeyRoot.Visible = false
    Main.Visible = true
    TweenService:Create(TransitionCover, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
end

local function SubmitKey()
    if Verifying then return end
    local keyText = KeyInput.Text
    if keyText == "" then
        SetKeyStatus("Please enter a key", Theme.Bad)
        return
    end
    Verifying = true
    SubmitLabel.Text = "Verifying key..."
    SpinnerPivot.Rotation = 0
    SpinnerPivot.Visible = true
    SpinTween:Play()
    SetKeyStatus("")
    task.delay(1.4, function()
        SpinTween:Cancel()
        SpinnerPivot.Visible = false
        Verifying = false
        if RequiredKey == "" or keyText == RequiredKey then
            SubmitLabel.Text = "Key Accepted"
            SetKeyStatus("Access granted", Theme.Good)
            task.delay(0.5, AcceptKey)
        else
            SubmitLabel.Text = "Submit Key"
            SetKeyStatus("Invalid key, try again", Theme.Bad)
        end
    end)
end

