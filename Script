local function MakeDraggable(dragHandle, target, onClick)
    local dragging = false
    local dragInput, mousePos, framePos
    local moved = false

    local function updatePosition(input)
        local delta = input.Position - mousePos
        if math.abs(delta.X) > 3 or math.abs(delta.Y) > 3 then
            moved = true
        end
        target.Position = UDim2.new(framePos.X.Scale, framePos.X.Offset + delta.X, framePos.Y.Scale, framePos.Y.Offset + delta.Y)
    end

    local function onInputBegan(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        dragging = true
        moved = false
        mousePos = input.Position
        framePos = target.Position

        local endConn
        endConn = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                endConn:Disconnect()
                if onClick and not moved then
                    onClick()
                end
            end
        end)
        Track(endConn)
    end

    local function onInputChanged(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end

    Track(dragHandle.InputBegan:Connect(onInputBegan))
    Track(dragHandle.InputChanged:Connect(onInputChanged))
    Track(UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            updatePosition(input)
        end
    end))
end

