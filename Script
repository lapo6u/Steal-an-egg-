local function SetTooltip(data, visible)
    if visible then
        data.Tooltip.Visible = true
        TweenService:Create(data.Tooltip, FastEase, {BackgroundTransparency = 0}):Play()
        TweenService:Create(data.TooltipLabel, FastEase, {TextTransparency = 0}):Play()
    else
        TweenService:Create(data.Tooltip, FastEase, {BackgroundTransparency = 1}):Play()
        TweenService:Create(data.TooltipLabel, FastEase, {TextTransparency = 1}):Play()
        task.delay(0.13, function()
            if data.Tooltip.BackgroundTransparency >= 1 then
                data.Tooltip.Visible = false
            end
        end)
    end
end

local function ActivateTab(data)
    if ActiveTab == data then return end
    if ActiveTab then
        TweenService:Create(ActiveTab.Button, Ease, {BackgroundTransparency = 1}):Play()
        TweenService:Create(ActiveTab.Stroke, Ease, {Transparency = 1}):Play()
        TweenService:Create(ActiveTab.Glyph, Ease, {TextColor3 = Theme.Idle}):Play()
    end
    ActiveTab = data
    TweenService:Create(data.Button, Ease, {BackgroundTransparency = 0.85}):Play()
    TweenService:Create(data.Stroke, Ease, {Transparency = 0}):Play()
    TweenService:Create(data.Glyph, Ease, {TextColor3 = Theme.Accent}):Play()
    Title.Text = data.Name

    local isHome = (data == HomeTab)
    CanvasTitle.Visible = not isHome
    if not isHome then
        CanvasTitle.Text = data.Name
    end

    for tabData, frame in pairs(ContentFrames) do
        frame.Visible = (tabData == data)
    end
end

